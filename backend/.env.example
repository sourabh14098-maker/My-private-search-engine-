# Ditch Google!R! Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Allowed CORS Origin for frontend client
CORS_ORIGIN=http://localhost:5173

# Demo mode: when true, defaults to mock index results
# When false, uses live search provider (e.g. Brave Search for Web)
DEMO_MODE=true

# Search Provider: 'mock' (default), 'searxng', or 'brave' (Web search vertical)
SEARCH_PROVIDER=mock

# SearXNG Metasearch Instance Configuration (Required if SEARCH_PROVIDER=searxng)
# Local or self-hosted instance URL (e.g. http://localhost:8080)
# Leave empty if no instance is running.
SEARXNG_URL=

# Brave Search API Credentials (Required if SEARCH_PROVIDER=brave)
# Keep backend-only: NEVER expose in frontend code, browser, or Git.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Outbound search provider timeout in milliseconds
SEARCH_TIMEOUT_MS=5000

# AI Answer Layer Provider: 'none' (default, privacy-first), 'ollama', 'openai', or 'custom'
# When 'none', DitchX never sends search data or queries to third-party AI services.
AI_PROVIDER=none

# Ollama Local AI Inference Configuration (Active when AI_PROVIDER=ollama)
# 1. Install Ollama from https://ollama.ai/download or your package manager
# 2. Pull your preferred local model (e.g. `ollama pull llama3.2:1b` or `ollama pull qwen2.5:3b`)
# 3. Ensure the Ollama daemon is running (`ollama serve`)
# 4. Set OLLAMA_MODEL below to match the exact model name pulled locally
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=15000
