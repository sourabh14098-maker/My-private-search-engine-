# Ditch Google!R! Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Allowed CORS Origin for frontend client
CORS_ORIGIN=http://localhost:5173

# Demo mode: when true, defaults to mock index results
# When false, uses live search provider (e.g. Brave Search for Web)
DEMO_MODE=true

# Search Provider: 'mock' (default) or 'brave' (Web search vertical)
SEARCH_PROVIDER=mock

# Brave Search API Credentials (Required if SEARCH_PROVIDER=brave)
# Keep backend-only: NEVER expose in frontend code, browser, or Git.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Outbound search provider timeout in milliseconds
SEARCH_TIMEOUT_MS=5000
